<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- The AniList token never leaves the device. Everything else
         (notably michi_settings.xml) keeps the default backup behavior. -->
    <cloud-backup>
        <exclude
            domain="sharedpref"
            path="michi_anilist_auth.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="sharedpref"
            path="michi_anilist_auth.xml" />
    </device-transfer>
</data-extraction-rules>
